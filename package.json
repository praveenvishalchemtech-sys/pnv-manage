{
  "name": "pnv-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "desktop:dev": "npm run build && electron .",
    "desktop:package": "npm run build && electron-builder --win nsis",
    "android:sync": "npm run build && cap sync android"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "firebase": "^11.6.0",
    "xlsx": "^0.18.5",
    "@capacitor/core": "^7.0.0",
    "@capacitor/android": "^7.0.0"
  },
  "devDependencies": {
    "vite": "^6.0.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "@capacitor/cli": "^7.0.0"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "in.pnvtraders.manager",
    "productName": "PNV Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
