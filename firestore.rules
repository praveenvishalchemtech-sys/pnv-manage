rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function profile(){return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;}
  function active(){return signedIn() && exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) && profile().active == true;}
  function manager(){return active() && profile().role == 'manager';}
  function shopStaff(){return active() && profile().role == 'staff' && profile().shop in ['Dharga','Muneeshwar Nagar'];}
  function shopAllowed(s){return manager() || (shopStaff() && profile().shop == s);}
  function validShop(s){return s in ['Dharga','Muneeshwar Nagar'];}
  function allowedKeys(){return ['shop','date','cash','upi','credit','refunds','openingCash','cashExpenses','countedCash','note','createdBy','createdAt','category','amount','sku','name','unit','cost','price','opening','reorder','productId','type','reason','qty','productName','staffId','staffName','status'];}
  function safeNew(){return request.resource.data.keys().hasOnly(allowedKeys()) && validShop(request.resource.data.shop) && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;}
  function nonnegative(x){return x is number && x >= 0 && x < 100000000;}
  match /profiles/{uid}{
   allow get: if signedIn() && (request.auth.uid == uid || manager());
   allow list: if manager();
   allow create, update, delete: if manager() && request.resource.data.keys().hasOnly(['name','role','shop','active']) && request.resource.data.role in ['manager','staff'] && (request.resource.data.role == 'manager' || validShop(request.resource.data.shop)) && uid != request.auth.uid;
  }
  match /sales/{id}{
   allow read: if active() && shopAllowed(resource.data.shop);
   allow create: if active() && safeNew() && shopAllowed(request.resource.data.shop) && request.resource.data.date is string && nonnegative(request.resource.data.cash) && nonnegative(request.resource.data.upi) && nonnegative(request.resource.data.credit) && nonnegative(request.resource.data.refunds) && nonnegative(request.resource.data.openingCash) && nonnegative(request.resource.data.cashExpenses) && nonnegative(request.resource.data.countedCash);
   allow update: if false;
   allow delete: if manager();
  }
  match /expenses/{id}{
   allow read: if active() && shopAllowed(resource.data.shop);
   allow create: if active() && safeNew() && shopAllowed(request.resource.data.shop) && request.resource.data.date is string && request.resource.data.category is string && nonnegative(request.resource.data.amount);
   allow update: if false;
   allow delete: if manager();
  }
  match /products/{id}{
   allow read: if active() && shopAllowed(resource.data.shop);
   allow create: if manager() && safeNew() && request.resource.data.name is string && request.resource.data.sku is string && nonnegative(request.resource.data.opening) && nonnegative(request.resource.data.reorder) && nonnegative(request.resource.data.price) && nonnegative(request.resource.data.cost);
   allow update: if manager() && resource.data.shop == request.resource.data.shop && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt;
   allow delete: if manager();
  }
  match /movements/{id}{
   allow read: if active() && shopAllowed(resource.data.shop);
   allow create: if active() && safeNew() && shopAllowed(request.resource.data.shop) && request.resource.data.date is string && request.resource.data.productId is string && request.resource.data.type in ['IN','OUT'] && nonnegative(request.resource.data.qty) && request.resource.data.qty > 0 && exists(/databases/$(database)/documents/products/$(request.resource.data.productId)) && get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.shop == request.resource.data.shop;
   allow update: if false;
   allow delete: if manager();
  }
  match /attendance/{id}{
   allow read: if active() && shopAllowed(resource.data.shop);
   allow create: if active() && safeNew() && shopAllowed(request.resource.data.shop) && request.resource.data.date is string && request.resource.data.status in ['Present','Absent','Leave','Half day'] && request.resource.data.staffId is string;
   allow update: if false;
   allow delete: if manager();
  }
 }
}